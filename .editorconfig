root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
# 中文正文较长，保留手动换行；列表内的行首空格有意义
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yaml,yml}]
indent_size = 2

[tools/split-book.mjs]
indent_size = 2
